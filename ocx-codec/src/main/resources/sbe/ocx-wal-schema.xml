<?xml version="1.0" encoding="UTF-8"?>
<!--
  SBE schema 版本纪律同 ocx-io-schema.xml：wire 变更必须递增 version 并同步
  Rust/黄金帧；当前 version=1 覆盖快照/恢复路径的全部字段演进。
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.ocx.codec.sbe.wal"
                   id="101"
                   version="1"
                   semanticVersion="1.1.0"
                   description="open-cex WAL 订单二进制负载（orderBin 字段）">

    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>

        <composite name="varString" description="Variable length UTF-8 string">
            <type name="length" primitiveType="uint32" maxValue="1024"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>

        <composite name="decimalValue" description="Decimal value as mantissa * 10^exponent">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8"/>
        </composite>

        <enum name="OrderDirection" encodingType="uint8" description="Order side">
            <validValue name="BUY">0</validValue>
            <validValue name="SELL">1</validValue>
        </enum>
    </types>

    <sbe:message name="OrderCreate" id="1"
                 description="Order 全量状态，ORDER_CREATE 时持久化到 WAL（与 Jackson 序列化字段一一对应）">
        <field name="orderId" id="1" type="int64"/>
        <field name="userId" id="2" type="int64" presence="optional"/>
        <field name="symbol" id="3" type="varString"/>
        <field name="origQty" id="4" type="decimalValue"/>
        <field name="executedQty" id="5" type="decimalValue"/>
        <field name="cumQuoteQty" id="6" type="decimalValue"/>
        <field name="coinSymbolPresent" id="7" type="uint8"/>
        <field name="coinSymbol" id="8" type="varString"/>
        <field name="baseSymbolPresent" id="9" type="uint8"/>
        <field name="baseSymbol" id="10" type="varString"/>
        <field name="orderStatusPresent" id="11" type="uint8"/>
        <field name="orderStatus" id="12" type="int32"/>
        <field name="orderType" id="13" type="varString"/>
        <field name="orderDirection" id="14" type="OrderDirection"/>
        <field name="timeInForce" id="15" type="varString"/>
        <field name="reduceOnly" id="16" type="uint8"/>
        <field name="price" id="17" type="decimalValue"/>
        <field name="time" id="18" type="int64" presence="optional"/>
        <field name="completedTime" id="19" type="int64" presence="optional"/>
        <field name="cancelTime" id="20" type="int64" presence="optional"/>
        <field name="cancelOrder" id="21" type="uint8"/>
        <field name="traceIdPresent" id="22" type="uint8"/>
        <field name="traceId" id="23" type="varString"/>
        <field name="visibleQtyPresent" id="24" type="uint8"/>
        <field name="visibleQty" id="25" type="decimalValue"/>
        <field name="displayedQtyPresent" id="26" type="uint8"/>
        <field name="displayedQty" id="27" type="decimalValue"/>
        <field name="triggerPricePresent" id="28" type="uint8"/>
        <field name="triggerPrice" id="29" type="decimalValue"/>
        <field name="triggerOrderTypePresent" id="30" type="uint8"/>
        <field name="triggerOrderType" id="31" type="varString"/>
        <field name="trailDeltaPresent" id="32" type="uint8"/>
        <field name="trailDelta" id="33" type="decimalValue"/>
        <field name="batchCancelUserId" id="34" type="int64" presence="optional"/>
    </sbe:message>
</sbe:messageSchema>
